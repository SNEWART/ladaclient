# ─────── SELF-CHECK (второй проход, только при подозрении) ───────
# Модель иногда «плывёт»: длинные монологи, echo вопроса, ответы
# не по тону, ремарки. Вместо переписывания всего всегда — вызываем
# второй проход ТОЛЬКО если сработал триггер. В 90% случаев 0 сек.
SELF_CHECK_ENABLED = True
